{
  "$defs": {
    "CursorState": {
      "additionalProperties": false,
      "description": "Cursor coordinates in the source screen coordinate system.",
      "properties": {
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        },
        "x": {
          "title": "X",
          "type": "integer"
        },
        "y": {
          "title": "Y",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "CursorState",
      "type": "object"
    },
    "PerceptionMode": {
      "description": "Standardized sources from which an observation can be assembled.",
      "enum": [
        "raw",
        "ocr",
        "a11y",
        "dom",
        "set_of_marks",
        "hybrid"
      ],
      "title": "PerceptionMode",
      "type": "string"
    },
    "ScreenObservation": {
      "additionalProperties": false,
      "description": "A captured screen encoded for transport to a vision model.\n\n``source_width`` and ``source_height`` preserve the native coordinate\nspace when the encoded image has been resized.",
      "properties": {
        "height": {
          "exclusiveMinimum": 0,
          "title": "Height",
          "type": "integer"
        },
        "image": {
          "description": "Base64-encoded image bytes",
          "minLength": 1,
          "title": "Image",
          "type": "string"
        },
        "image_format": {
          "default": "png",
          "pattern": "^[a-z0-9][a-z0-9.+-]*$",
          "title": "Image Format",
          "type": "string"
        },
        "monitor": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monitor"
        },
        "origin_x": {
          "default": 0,
          "title": "Origin X",
          "type": "integer"
        },
        "origin_y": {
          "default": 0,
          "title": "Origin Y",
          "type": "integer"
        },
        "source_height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Height"
        },
        "source_width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Width"
        },
        "width": {
          "exclusiveMinimum": 0,
          "title": "Width",
          "type": "integer"
        }
      },
      "required": [
        "width",
        "height",
        "image"
      ],
      "title": "ScreenObservation",
      "type": "object"
    },
    "WindowInfo": {
      "additionalProperties": false,
      "description": "Portable metadata describing a desktop window.",
      "properties": {
        "application": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Application"
        },
        "focused": {
          "default": false,
          "title": "Focused",
          "type": "boolean"
        },
        "height": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Height"
        },
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Id"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        },
        "title": {
          "default": "",
          "title": "Title",
          "type": "string"
        },
        "width": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Width"
        },
        "x": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "X"
        },
        "y": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Y"
        }
      },
      "title": "WindowInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A provider-independent snapshot of observable computer state.",
  "properties": {
    "accessibility": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessibility"
    },
    "active_window": {
      "anyOf": [
        {
          "$ref": "#/$defs/WindowInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "cursor": {
      "anyOf": [
        {
          "$ref": "#/$defs/CursorState"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "dom": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Dom"
    },
    "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
    },
    "metadata": {
      "additionalProperties": true,
      "title": "Metadata",
      "type": "object"
    },
    "mode": {
      "$ref": "#/$defs/PerceptionMode",
      "default": "raw"
    },
    "ocr": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Ocr",
      "type": "array"
    },
    "screen": {
      "$ref": "#/$defs/ScreenObservation"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "windows": {
      "items": {
        "$ref": "#/$defs/WindowInfo"
      },
      "title": "Windows",
      "type": "array"
    }
  },
  "required": [
    "screen"
  ],
  "title": "Observation",
  "type": "object"
}
